# Local development. Production gets these from Key Vault via infra/deploy.sh.
DATABASE_URL=postgresql://emp:PASSWORD@emp-pg.postgres.database.azure.com:5432/employee?sslmode=require
AZURE_OPENAI_RESOURCE=zybit-project-resource
MODEL=gpt-5.6-sol
MODELS=gpt-5.6-sol,gpt-5.4
REASONING_EFFORT=high
# ADMIN_PASSWORD=   # unset = no login prompt (local only)
BASE_URL=http://localhost:8080
# Linked accounts (OAuth). Microsoft secret: az keyvault secret show --vault-name zybit-emp-kv -n graph-client-secret --query value -o tsv
MS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
